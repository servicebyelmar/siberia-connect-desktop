<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SiberiaConnect</AssemblyName>
    <RootNamespace>SiberiaConnect</RootNamespace>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>Siberia Connect</Product>
    <Company>Siberia Connect</Company>
    <Description>Siberia Connect VPN</Description>
    <Copyright>© 2026 Siberia Connect</Copyright>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Пакет WebView2 для net5.0+ сам подключает ещё и Microsoft.Web.WebView2.Wpf.dll (build/Common.targets).
       WPF здесь не используется, а эта сборка тянет WindowsBase 5.0.0.0 против 4.0.0.0 из ссылочных сборок .NET (MSB3277).
       Убираем её из ссылок: пропадает предупреждение и лишняя сборка в публикации. Core и WinForms остаются. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_WebView2WpfRef Include="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <Reference Remove="@(_WebView2WpfRef)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Bridge.js" LogicalName="Bridge.js" />
    <EmbeddedResource Include="Offline.html" LogicalName="Offline.html" />
    <EmbeddedResource Include="Compact.js" LogicalName="Compact.js" />
    <EmbeddedResource Include="..\assets\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="..\assets\app_off.ico" LogicalName="app_off.ico" />
    <!-- анимация логотипа: ролик, кадры, вой (wolf_howl.mp3 подхватится, как только файл появится в assets\wolf) -->
    <EmbeddedResource Include="..\assets\wolf\*" LogicalName="wolf/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
